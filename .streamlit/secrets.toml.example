# Copy this file to .streamlit/secrets.toml and fill in your real values.
# Get client_id and client_secret by creating an OAuth 2.0 Client ID
# in Google Cloud Console (see README for step-by-step instructions).
#
# NEVER commit the real secrets.toml to GitHub - it's already in .gitignore.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace_this_with_any_random_long_string"

[auth.google]
client_id = "your_google_client_id.apps.googleusercontent.com"
client_secret = "your_google_client_secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
